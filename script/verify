#!/usr/bin/env ruby
# frozen_string_literal: true

# Independently recheck every stored certificate with plain geometry — no SAT,
# no solver trust. Heesch (non-tiler) certificates are refutation-backed: their
# positive half (the saved corona witness) is rechecked here; their negative
# half is drat-trim's jurisdiction (the DRAT proof under cnf/).
# Exits nonzero if anything fails.
#
# Usage: script/verify [--artifacts]
#
# --artifacts also hashes every computed proof that is on disk against its
# record, and requires a proof that is not on disk to be in the manifest
# (data/artifacts.json). Slow: the biggest proof is gigabytes.

require_relative "../lib/census"

check_artifacts = ARGV.delete("--artifacts")
root = File.expand_path("../data", __dir__)
manifest_path = File.join(root, "artifacts.json")
manifest = File.exist?(manifest_path) ? JSON.parse(File.read(manifest_path), symbolize_names: true)[:artifacts] : {}
artifacts_checked = 0
checked = 0
unresolved = 0
refutation_backed = []
computations = Hash.new(0)
shapes = Hash.new(0)
achiral = Hash.new(0)
failures = []

Dir.glob(File.join(root, "*", "*", "shape.json")).sort.each do |path|
  record = JSON.parse(File.read(path), symbolize_names: true)

  shapes[record[:n]] += 1
  achiral[record[:n]] += 1 if record[:chiral] == false

  # D2 invariant: an achiral shape's 48-isometry placement set equals its
  # 24-rotation set, so the two tiling columns can never legitimately differ.
  if record[:chiral] == false && record[:tiles_rotations_only] != record[:tiles_with_reflections]
    failures << "#{record[:id]} (achiral D2 invariant)"
  end

  # Stages are derived from the other fields and stored for readers, so an
  # array that disagrees with its own record has been edited by hand.
  failures << "#{record[:id]} (stages)" unless record[:stages] == Census::Stages.new(record:).to_a

  certificate = record[:certificate]
  if certificate.nil?
    unresolved += 1
    next
  end

  shape = Census::Polycube.new(cells: record[:cells])

  if certificate[:type] == "heesch"
    refutation_backed << record[:id]

    # Provenance: every refutation names its kind and whether this record did
    # the computing. A derived record leans on its mirror twin, which must
    # hold the same evidence and must have computed it.
    kind = certificate[:refutation_kind]
    provenance = certificate[:provenance]
    failures << "#{record[:id]} (refutation_kind #{kind.inspect})" unless %w[ledger proof].include?(kind)
    failures << "#{record[:id]} (provenance #{provenance.inspect})" unless %w[computed derived].include?(provenance)
    failures << "#{record[:id]} (proof without sha256)" if kind == "proof" && certificate[:refutation_sha256].nil?
    if provenance == "computed"
      computations[kind] += 1
      failures << "#{record[:id]} (computed yet derived_from)" unless certificate[:derived_from].nil?

      # The manifest's raw checksum for a published proof must be the one the
      # record names, or the bucket holds some other bytes than the claim.
      if kind == "proof"
        proof_relative = "#{record[:id]}/#{certificate[:refutation]}"
        entry = manifest[proof_relative.to_sym]
        failures << "#{record[:id]} (manifest sha256 differs from the record)" if entry && entry[:sha256] != certificate[:refutation_sha256]
        if check_artifacts
          proof_path = File.join(root, proof_relative)
          if File.exist?(proof_path)
            failures << "#{record[:id]} (proof bytes differ from refutation_sha256)" unless Digest::SHA256.file(proof_path).hexdigest == certificate[:refutation_sha256]
          elsif entry.nil?
            failures << "#{record[:id]} (proof neither on disk nor in the manifest)"
          end
          artifacts_checked += 1
        end
      end
    else
      source_path = File.join(root, certificate[:derived_from].to_s, "shape.json")
      source = File.exist?(source_path) ? JSON.parse(File.read(source_path), symbolize_names: true) : {}
      sound = certificate[:derived_from] == record[:mirror_id] &&
              source.dig(:certificate, :provenance) == "computed" &&
              source.dig(:certificate, :refutation_kind) == kind &&
              source.dig(:certificate, :refutation_sha256) == certificate[:refutation_sha256] &&
              source[:heesch] == record[:heesch]
      failures << "#{record[:id]} (derived from #{certificate[:derived_from]})" unless sound
    end

    witness_path = File.join(File.dirname(path), "corona1.json")
    if File.exist?(witness_path)
      placements = JSON.parse(File.read(witness_path), symbolize_names: true)
      reconstructed = placements.map { it.merge(cells: Census::Assembly.placed_cells(it, shape)) }
      failures << "#{record[:id]} (corona1 witness)" unless Census::Surround.new(shape:).verified?(reconstructed)
      checked += 1
    end
    next
  end

  failures << record[:id] unless Census::Verifier.new(certificate:, shape:).valid?
  checked += 1
end

# Burnside, with the two-element group {identity, mirror} acting on the
# shapes of one size: mirror-identified classes = (shapes + achiral) / 2.
# OEIS gives both counts, so the achiral tally in data/ is pinned by them.
shapes.keys.sort.each do |n|
  expected_shapes = Census::OEIS::A000162[n - 1]
  expected_classes = Census::OEIS::A038119[n - 1]
  failures << "n=#{n} (#{shapes[n]} shapes, A000162 says #{expected_shapes})" unless shapes[n] == expected_shapes
  failures << "n=#{n} (#{achiral[n]} achiral, Burnside and A038119 say #{(2 * expected_classes) - expected_shapes})" unless shapes[n] + achiral[n] == 2 * expected_classes
end

puts "verified #{checked} certificates, #{unresolved} unresolved shapes"
puts "shape and achiral counts through n=#{shapes.keys.max} match A000162 and A038119 by Burnside"
if refutation_backed.any?
  puts "refutation-backed non-tilers (recheck with drat-trim against cnf/): #{refutation_backed.join(', ')}"
  summary = computations.sort.map { |kind, count| "#{count} #{kind}" }.join(", ")
  puts "resting on #{computations.values.sum} independent computations (#{summary}), the rest derived by mirror"
end
puts "#{artifacts_checked} proofs hashed against their records and the manifest" if check_artifacts
abort "FAILED: #{failures.join(', ')}" if failures.any?
