#!/usr/bin/env ruby
# frozen_string_literal: true

# Draw a shape as SVG, seen through a perspective camera.
#
# Usage:
#   script/render <id> [options] > shape.svg
#   script/render <id> --sheet > poses.svg        # all 24 rotations, labelled, to pick a pose
#
# Options, each with a default:
#   --rotation N        which of the 24 rotations of the canonical cells   0
#   --azimuth DEG       camera angle around z, from +x toward +y           30
#   --elevation DEG     camera angle above the xy plane                    20
#   --distance WIDTHS   camera distance in multiples of the shape's width  3
#   --size PX           image width and height                             512
#   --background HEX    square fill behind the shape                       none
#
# Azimuth 45, elevation 35.264 and a large distance is true isometric. SVG goes
# to stdout. For a PNG: script/render 9/42947 | rsvg-convert -w 1024 > out.png
#
# The org avatar is: script/render 9/42947 --size 1024 --background "#f6f8fa"

require_relative "../lib/census"

def option(arguments, flag, default)
  return default unless (position = arguments.index(flag))

  arguments.delete_at(position)
  arguments.delete_at(position)
end

def flag?(arguments, flag)
  return false unless (position = arguments.index(flag))

  arguments.delete_at(position)
  true
end

arguments = ARGV.dup
sheet = flag?(arguments, "--sheet")
rotation_index = Integer(option(arguments, "--rotation", 0))
azimuth = Float(option(arguments, "--azimuth", 30))
elevation = Float(option(arguments, "--elevation", 20))
distance = Float(option(arguments, "--distance", 3))
size = Integer(option(arguments, "--size", 512))
background = option(arguments, "--background", nil)
id = arguments.fetch(0) { abort "usage: script/render <id> [options]" }

record = JSON.parse(File.read(File.expand_path("../data/#{id}/shape.json", __dir__)), symbolize_names: true)
shape = Census::Polycube.new(cells: record[:cells])

def render(cells, azimuth:, elevation:, distance:, size:, background:)
  camera = Census::Camera.new(cells:, azimuth:, elevation:, distance:)
  Census::SVG.new(cells:, camera:, size:, background:).render
end

unless sheet
  cells = shape.rotated(Census::Rotation.all.fetch(rotation_index)).cells
  puts render(cells, azimuth:, elevation:, distance:, size:, background:)
  exit
end

# A contact sheet: every rotation as a nested SVG, numbered so the one that
# reads best can be named with --rotation.
tile = 160
columns = 6
rows = 4
puts %(<svg xmlns="http://www.w3.org/2000/svg" width="#{columns * tile}" height="#{rows * tile}" viewBox="0 0 #{columns * tile} #{rows * tile}">)
puts %(<rect width="100%" height="100%" fill="white"/>)
Census::Rotation.all.each_with_index do |rotation, index|
  x = (index % columns) * tile
  y = (index / columns) * tile
  inner = render(shape.rotated(rotation).cells, azimuth:, elevation:, distance:, size: tile, background: nil)
  puts %(<text x="#{x + 6}" y="#{y + 18}" font-family="Helvetica" font-size="14" fill="#444">#{index}</text>)
  puts inner.sub("<svg ", %(<svg x="#{x}" y="#{y}" ))
end
puts "</svg>"
