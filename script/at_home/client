#!/usr/bin/env ruby
# frozen_string_literal: true

# A polycubing@home volunteer client
# Usage:
#
#   script/at_home/client
#
# Options.
# Each has a default, so all are optional.
#
#   --url URL                 coordinator address
#                               default:  $POLYCUBE_AT_HOME
#                               or:       http://127.0.0.1:9292
#   --handle HANDLE           permanent scheduling ID, opaque and never displayed
#                               default: read from ~/.polycubing-at-home/handle,
#                               generated on first run and reused after, so a
#                               restart is the same volunteer and not a new one
#                               override the location with POLYCUBE_AT_HOME_HANDLE
#   --name NAME               display name for credits — subject to approval
#                             before it appears in data/
#                               default: none
#                               and credit falls back to the handle
#   --contact CONTACT_INFO    how to reach you, if you want to be reachable
#                               default: none
#   --limit N                 stop after N units
#                               default: no limit
#   --give-up-after SECONDS   stop if the coordinator stays unreachable this long
#                               default: wait indefinitely
#   --cube-timeout SECONDS    how long to spend on one cube before handing it
#                             back as too hard, for the coordinator to split
#                               default: 3600
#   --formulas DIR            where to cache formulas fetched from the
#                             coordinator, keyed by digest and shared
#                             between every cube unit of one shape
#                               default: formulas/
#   --proofs DIR              where to keep DRAT refutations, named by their
#                             own digest, so one can be handed over on request
#                               default: proofs/
#   --disk-floor-gb GB        take no new work while this disk has less free
#                             than this. Your limit, which the coordinator
#                             cannot know for you
#                               default: none
#   --once                    stop when the queue is empty rather than waiting
#                             (a coordinator asking for a pause is not an
#                             empty queue, and is waited out)
#
# The client holds no census state.
# It leases a unit, solves it locally, then returns the answer to the server.
# Everything it returns is re-verified by the server.
#
# Examples:
#
#   script/at_home/client
#   script/at_home/client --url https://example.com
#   script/at_home/client --url https://example.com --name sbb
#   script/at_home/client --url https://example.com --contact veganstraightedge@gmail.com
#   script/at_home/client --limit 10
#   script/at_home/client --once

require 'fileutils'
require 'securerandom'
require 'socket'
require_relative '../../lib/census'

# Read options
arguments = ARGV.dup

def option arguments, flag, default
  position = arguments.index flag
  return default if position.nil?

  arguments.slice!(position, 2).last
end

def flag? arguments, flag
  position = arguments.index flag
  return false if position.nil?

  arguments.delete_at position

  true
end

def check_for_unknown_options arguments
  return if arguments.empty?

  abort "unknown option(s): #{arguments.join(' ')}"
end

def default_url          = ENV.fetch 'POLYCUBE_AT_HOME', 'http://127.0.0.1:9292'
def default_formulas     = Census::AtHome::Client::DEFAULT_FORMULAS
def default_cube_timeout = Census::AtHome::Client::DEFAULT_CUBE_TIMEOUT
def default_proofs       = Census::AtHome::Client::DEFAULT_PROOFS
def handle_file          = ENV.fetch 'POLYCUBE_AT_HOME_HANDLE', File.expand_path('~/.polycubing-at-home/handle')
def reporter             = ->(line) { puts "#{Time.now.utc.iso8601}  #{line}" }

# A volunteer is one identity, not one process.
#
# The handle used to carry the pid, so every restart registered a stranger.
# That scattered credits across dozens of one-unit contributors, and left the
# coordinator asking for a proof from an identity that would never return.
# Written once and reused, so several clients on one machine are one volunteer.
def default_handle
  return File.read(handle_file).strip if File.exist? handle_file

  handle = "client-#{Socket.gethostname}-#{SecureRandom.hex 4}"

  FileUtils.mkdir_p File.dirname(handle_file)
  File.write handle_file, "#{handle}\n"

  handle
end

# Extract options
url            = option arguments, '--url',           default_url
handle         = option arguments, '--handle',        default_handle
display_name   = option arguments, '--name',          nil
contact        = option arguments, '--contact',       nil
formulas       = option arguments, '--formulas',      default_formulas
proofs         = option arguments, '--proofs',        default_proofs
limit          = option(arguments, '--limit',         nil)&.then { Integer(it) }
give_up_after  = option(arguments, '--give-up-after', nil)&.then { Integer(it) }
cube_timeout   = option(arguments, '--cube-timeout',  default_cube_timeout).then { Integer(it) }
disk_floor_gb  = option(arguments, '--disk-floor-gb', nil)&.then { Float(it) }
once           = flag?  arguments, '--once'

# Check options
check_for_unknown_options arguments

disk_floor_bytes = disk_floor_gb && (disk_floor_gb * 1_000_000_000).to_i

client = Census::AtHome::Client.new url:,
                                    handle:,
                                    display_name:,
                                    contact:,
                                    give_up_after:,
                                    cube_timeout:,
                                    disk_floor_bytes:,
                                    formulas:,
                                    proofs:,
                                    report: reporter

tally = begin
  client.run(limit:, once:)
rescue Interrupt
  puts
  puts 'stopped by user request (control-c)'
  puts
  {}
end

puts "done: #{tally.sort.to_h.inspect}"
puts
