#!/usr/bin/env ruby
# frozen_string_literal: true

# Turn a finished cube campaign into the record's claim.
#
# Usage:
#   script/at_home/archive-cubes <id> [options]
#
# Options.
#
#   --depth K                 which corona the campaign refuted
#                               default: the record's reached.corona_refuted
#   --settle                  first close any splits a missed roll-up left
#                             open, then archive
#                               default: archive only
#   --published               require every leaf's proof to be in the
#                             bucket's ledger (data/<id>/cnf/corona<K>.published.json,
#                             written by script/at_home/publish-proofs) and
#                             give each manifest line its proof's URL and
#                             compressed checksum
#                               default: digests only
#
# Writes data/<id>/cnf/corona<K>.proofs.json, one line per leaf cube with its
# proof's digest, and stamps the record (and a mirror twin that derives from
# it) with refutation_kind cube_proofs and the manifest's digest. Refuses
# unless the shape unit is done, which the roll-up grants only when every
# leaf's proof was checked. Commit the result by hand.
#
# Example, the triskelion, on the coordinator's machine once the ledger is
# pulled there:
#
#   script/at_home/archive-cubes 9/42947 --settle --published

require_relative "../../lib/census"

def option(arguments, flag, default)
  position = arguments.index(flag)
  return default if position.nil?

  arguments.slice!(position, 2).last
end

def flag?(arguments, flag)
  position = arguments.index(flag)
  return false if position.nil?

  arguments.delete_at(position)
  true
end

arguments = ARGV.dup
settling = flag?(arguments, "--settle")
published = flag?(arguments, "--published")
depth = option(arguments, "--depth", nil)
unknown = arguments.select { it.start_with?("--") }
abort "unknown option(s): #{unknown.join(' ')}" unless unknown.empty?

id = arguments.shift
abort "usage: script/at_home/archive-cubes <id> [--depth K] [--settle] [--published]" if id.nil? || !arguments.empty?

root = File.expand_path("../../data", __dir__)
record = JSON.parse(File.read(File.join(root, id, "shape.json")), symbolize_names: true)
depth = Integer(depth || record.dig(:reached, :corona_refuted) || abort("no depth known for #{id}, pass --depth"))

vendor = File.expand_path("../../vendor/drat-trim", __dir__)
commit = `git -C #{vendor} rev-parse --short HEAD 2>/dev/null`.strip
checker = commit.empty? ? "drat-trim (version unrecorded)" : "drat-trim #{commit}"
solver = "kissat #{`kissat --version`.strip}"

ledger = nil
if published
  ledger_path = Census::AtHome::ProofLedger.path(root:, shape_id: id, depth:)
  abort "no ledger at #{ledger_path}; run script/at_home/publish-proofs on the laptop and pull it here" unless File.exist?(ledger_path)
  ledger = Census::AtHome::ProofLedger.new(path: ledger_path, shape_id: id, depth:)
  puts "ledger: #{ledger.size} proofs in the bucket"
end

store = Census::AtHome::Store.new
policy = ENV.fetch("AT_HOME_PROOF_POLICY", "every").to_sym
coordinator = Census::AtHome::Coordinator.new(store:, proof_policy: policy)

if settling
  closed = coordinator.settle(shape_id: id)
  puts "settled #{closed} split unit(s)"
end

archiver = Census::AtHome::CubeArchiver.new(store:, root:, shape_id: id, depth:, checker:, solver:, ledger:)
result = archiver.archive
puts "#{id}: #{result[:leaves]} leaf proofs, manifest #{result[:manifest]}"
puts "manifest sha256 #{result[:sha256]}"
puts "twin #{result[:twin]} restamped" if result[:twin]

store.close
