#!/usr/bin/env ruby
# frozen_string_literal: true

# The polycubing@home coordinator server
# Usage:
#
#   script/at_home/server
#
# Options.
# Each has a default, so all are optional.
#
#   --port PORT               port to listen on
#                               default: $PORT
#                               or:      9292
#   --threads THREADS         number of threads to use
#                               default: $AT_HOME_THREADS
#                               or:      16
#   --proof-policy POLICY     on_request: proofs are asked for by hand, and a
#                             parent settles on claimed digests
#                             every: each proof is asked for as soon as it is
#                             claimed, checked on arrival, and a parent settles
#                             only on checked proofs
#                               default: $AT_HOME_PROOF_POLICY
#                               or:      on_request
#   --max-proof-bytes N       upload cap for one proof
#                               default: $AT_HOME_MAX_PROOF_BYTES
#                               or:      104857600 (GitHub's blob limit)
#   --check-timeout SECONDS   how long drat-trim may spend on one proof
#                               default: $AT_HOME_CHECK_TIMEOUT
#                               or:      300
#
# A thin wrapper over `puma -C config/puma.rb`
# Both this and `puma` load config.ru, so you may use either to start the server.
#
# Examples:
#
#   script/at_home/server
#   script/at_home/server --port 5678
#   script/at_home/server --threads 37
#   PORT=5678 AT_HOME_THREADS=37 script/at_home/server

# Read options
arguments = ARGV.dup

def option arguments, flag, default
  position = arguments.index flag
  return default if position.nil?

  arguments.slice!(position, 2).last
end

def check_for_unknown_options arguments
  return if arguments.empty?

  abort "unknown option(s): #{arguments.join(' ')}"
end

# Extract options
ENV['PORT']                    = option arguments, '--port',            ENV.fetch('PORT', '9292')
ENV['AT_HOME_THREADS']         = option arguments, '--threads',         ENV.fetch('AT_HOME_THREADS', '16')
ENV['AT_HOME_PROOF_POLICY']    = option arguments, '--proof-policy',    ENV.fetch('AT_HOME_PROOF_POLICY', 'on_request')
ENV['AT_HOME_MAX_PROOF_BYTES'] = option arguments, '--max-proof-bytes', ENV.fetch('AT_HOME_MAX_PROOF_BYTES', (100 * 1024 * 1024).to_s)
ENV['AT_HOME_CHECK_TIMEOUT']   = option arguments, '--check-timeout',   ENV.fetch('AT_HOME_CHECK_TIMEOUT', '300')

# Check options
check_for_unknown_options arguments

Dir.chdir File.expand_path('../..', __dir__) do
  exec 'bundle', 'exec', 'puma', '-C', 'config/puma.rb'
end
