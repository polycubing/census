#!/usr/bin/env ruby
# frozen_string_literal: true

# Stamp every unresolved chiral shape whose mirror twin already holds a
# box/torus certificate: reflect the twin's tiling, verify it independently,
# write the verdict. Serial by design — run between sharded census rounds,
# never alongside them. Usage: script/propagate-mirrors [max_n]

require_relative "../lib/census"

max_size = Integer(ARGV.fetch(0, "9"))
root = File.expand_path("../data", __dir__)
propagated = 0

(1..max_size).each do |size|
  Dir.glob(File.join(root, size.to_s, "*", "shape.json")).sort.each do |path|
    record = JSON.parse(File.read(path), symbolize_names: true)
    next if record[:verdict] || !record[:chiral]

    twin_path = File.join(root, "#{record[:mirror_id]}/shape.json")
    twin_record = JSON.parse(File.read(twin_path), symbolize_names: true)
    shape = Census::Polycube.new(cells: twin_record[:cells])
    twin = Census::Polycube.new(cells: record[:cells])

    case twin_record.dig(:certificate, :type)
    when "box", "torus"
      certificate = Census::MirroredCertificate.new(certificate: twin_record[:certificate], shape:, twin:).certificate
      raise "mirrored certificate failed verification for #{record[:id]}" unless Census::Verifier.new(certificate:, shape: twin).valid?

      stamped = record.merge(
        verdict: "tiler",
        tiles_rotations_only: true,
        tiles_with_reflections: true,
        certificate:,
        budgets: twin_record[:budgets],
        credits: record[:credits].merge(solved_by: "polycube-census v#{Census::VERSION} (mirrored from #{twin_record[:id]})")
      )
      File.write(path, Census::JSONDocument.new(stamped).generate)
      puts "#{record[:id]}  tiler  mirrored from #{twin_record[:id]} (verified)"
      propagated += 1
    when "heesch"
      # A tiling of the twin would reflect to a tiling of the solved shape,
      # which its refutation forbids — so the twin is a non-tiler with the
      # same Heesch number. Mirror the corona-1 witness and verify it.
      witness_path = File.join(root, "#{twin_record[:id]}/corona1.json")
      next unless File.exist?(witness_path)

      compact = JSON.parse(File.read(witness_path), symbolize_names: true)
      mirrored = Census::MirroredWitness.new(placements: compact, shape:, twin:).placements
      surround = Census::Surround.new(shape: twin)
      reconstructed = mirrored.map { it.merge(cells: Census::Assembly.placed_cells(it, twin)) }
      raise "mirrored witness failed verification for #{record[:id]}" unless surround.verified?(reconstructed)

      File.write(File.join(root, "#{record[:id]}/corona1.json"), "#{JSON.generate(mirrored)}\n")
      stamped = record.merge(
        verdict: "non_tiler",
        tiles_rotations_only: false,
        tiles_with_reflections: false,
        certificate: {
          type: "heesch",
          heesch: twin_record[:heesch],
          adjacency: twin_record.dig(:certificate, :adjacency) || "26",
          derived_from: twin_record[:id],
          provenance: "derived",
          refutation: "mirror of #{twin_record[:id]} — data/#{twin_record[:id]}/#{twin_record.dig(:certificate, :refutation)}",
          refutation_kind: twin_record.dig(:certificate, :refutation_kind),
          refutation_sha256: twin_record.dig(:certificate, :refutation_sha256),
          solved_with: "witnesses and verdict mirrored from #{twin_record[:id]}"
        },
        heesch: twin_record[:heesch],
        budgets: twin_record[:budgets],
        reached: twin_record[:reached],
        credits: record[:credits].merge(solved_by: "polycube-census v#{Census::VERSION} (mirrored from #{twin_record[:id]})")
      )
      File.write(path, Census::JSONDocument.new(stamped).generate)
      puts "#{record[:id]}  non_tiler  heesch #{twin_record[:heesch]}  mirrored from #{twin_record[:id]} (witness verified)"
      propagated += 1
    end
  end
end

puts "propagated #{propagated} certificates"
