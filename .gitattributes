# The census archive is generated, never hand-authored. Marking it keeps GitHub
# from counting it in language statistics and collapses it in diff views.
data/** linguist-generated=true

# Line endings are pinned so a volunteer on Windows checks these out byte for
# byte identical to everyone else. Without this, git would hand them CRLF and
# every record they archived back would differ by line ending alone.
data/** text eol=lf

# Except DRAT proofs, which kissat writes in its binary format. Line-ending
# normalization inside those bytes would corrupt the refutation, and a corrupt
# proof is worse than no proof: it fails to check, and the shape it refutes
# looks unproven when it isn't.
*.drat -text

# Compressed artifacts likewise: a database dump under data/ was stored with
# its bytes "normalized" once, and came back unreadable.
*.xz -text
